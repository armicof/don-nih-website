# Python backend reads .env at the project root; never put secrets in frontend env.
HOST=127.0.0.1
PORT=8000
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=PSOFP-db123
SESSION_HOURS=168
# false is required for local HTTP; set true behind HTTPS before exposing a deployment.
COOKIE_SECURE=false
# Comma-separated exact browser origins, not API endpoints.
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# Supabase and Midtrans are NOT connected in this local implementation.
# No credentials or preconfigured admin account are required/provided.
